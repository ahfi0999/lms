generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PasswordResetTicket {
  id        Int       @id @default(autoincrement())
  userId    Int
  token     String    @unique
  createdAt DateTime  @default(now())
  usedAt    DateTime?
}

model EmailVerificationTicket {
  id        Int       @id @default(autoincrement())
  userId    Int
  token     String    @unique
  createdAt DateTime  @default(now())
  usedAt    DateTime?
}

model Course {
  id            Int          @id @default(autoincrement())
  title         String
  description   String
  picture       String
  archived      Boolean      @default(false)
  liveLink      String?
  projectFiles  Attachment[] @relation("projectFiles")
  resourceFiles Attachment[] @relation("resourceFiles")
  modulesOrder  Int[]
  resumeFiles   String[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt
  assignments   Assignment[]
  modules       Module[]
  users         String[]
  contentLink   String?
}

model Module {
  id        Int      @id @default(autoincrement())
  title     String
  courseId  Int
  course    Course   @relation(fields: [courseId], references: [id])
  topics    Topic[]
  updatedAt DateTime @default(now()) @updatedAt
  createdAt DateTime @default(now())
}

model Topic {
  id          Int          @id @default(autoincrement())
  title       String
  moduleId    Int          @map("modulesId")
  videoLink   String?
  module      Module?      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  attachments Attachment[]
}

model Assignment {
  id           Int        @id @default(autoincrement())
  courseId     Int
  attachment   Attachment @relation(fields: [attachmentId], references: [id])
  createdAt    DateTime   @default(now())
  Course       Course     @relation(fields: [courseId], references: [id])
  attachmentId Int        @unique
  user         String
}

model Attachment {
  id                    Int         @id @default(autoincrement())
  title                 String      @db.VarChar(255)
  file                  String
  description           String?
  createdAt             DateTime    @default(now())
  assignment            Assignment?
  projectFilesCourse    Course?     @relation("projectFiles", fields: [projectFilesCourseId], references: [id])
  projectFilesCourseId  Int?
  resourceFilesCourse   Course?     @relation("resourceFiles", fields: [resourceFilesCourseId], references: [id])
  resourceFilesCourseId Int?
  topic                 Topic?      @relation(fields: [topicId], references: [id])
  topicId               Int?
}

model AppEvent {
  id        Int       @id @default(autoincrement())
  type      AppEventType
  user      User      @relation(fields: [userId], references: [id])
  data      Json
  createdAt DateTime  @default(now())
  userId    String
}

enum AppEventType {
  COURSE_ACCESS
}

model EmailLog {
  id        Int            @id @default(autoincrement())
  to        String
  subject   String
  body      String
  template  String?
  sentBy    String
  status    EmailLogStatus @default(SENT)
  error     String?
  createdAt DateTime       @default(now())
}

enum EmailLogStatus {
  SENT
  FAILED
}

model SyncLog {
  id          Int           @id @default(autoincrement())
  type        String
  triggeredBy String
  status      SyncLogStatus
  synced      Int           @default(0)
  failed      Int           @default(0)
  duration    Int           @default(0)
  error       String?
  records     SyncLogRecord[]
  createdAt   DateTime      @default(now())
}

model SyncLogRecord {
  id        Int      @id @default(autoincrement())
  syncLogId Int
  syncLog   SyncLog  @relation(fields: [syncLogId], references: [id], onDelete: Cascade)
  email     String
  name      String?
  status    String
  error     String?
  createdAt DateTime @default(now())
}

enum SyncLogStatus {
  SUCCESS
  PARTIAL
  FAILED
}

model User {
  id    String  @id
  name  String
  email String
  Event AppEvent[]
}

model EmailAccount {
  id           Int      @id @default(autoincrement())
  label        String
  email        String   @unique
  imapHost     String   @default("imap.gmail.com")
  imapPort     Int      @default(993)
  smtpHost     String   @default("smtp.gmail.com")
  smtpPort     Int      @default(587)
  appPassword  String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model AppSettings {
  id                     Int      @id @default(1)
  // General
  platformName           String   @default("LMS Platform")
  supportEmail           String   @default("")
  timezone               String   @default("UTC")
  maintenanceMode        Boolean  @default(false)
  maintenanceMessage     String   @default("We are currently undergoing scheduled maintenance. Please check back soon.")
  // Enrollment
  selfEnrollment         Boolean  @default(true)
  defaultBatchCapacity   Int      @default(30)
  waitlistEnabled        Boolean  @default(false)
  // Notifications
  notifyOnEnrollment     Boolean  @default(true)
  notifyOnCompletion     Boolean  @default(true)
  notifyOnCertificate    Boolean  @default(true)
  adminAlertEmail        String   @default("")
  // Certificates
  certificateIssuer      String   @default("")
  autoIssueCertificate   Boolean  @default(false)
  // Security
  allowedDomains         String[] @default([])
  sessionTimeoutMinutes  Int      @default(1440)
  updatedAt              DateTime @default(now()) @updatedAt
}
